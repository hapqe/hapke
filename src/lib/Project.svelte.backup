<script context="module">
  import { writable } from "svelte/store";

  export const fullscreenProject = writable("");
</script>

{#if $fullscreenProject}
  <main>
    <button
      on:click={() => {
        document.startViewTransition(() => {
          fullscreenProject.set("");
        });
      }}>close</button
    >
    <img class="fullscreen" src="/projects/3d/6.jpg" alt="" />
  </main>
{/if}

<style>
  main {
    top: 0;
    position: fixed;
    width: 80svw;
    height: auto;
    img {
      width: 100%;
    }
  }
  button {
    pointer-events: all;
  }
</style>
